---
import { renderInline, asset } from '../lib/inline.mjs';
const { title, nativeTitle, romaji, rows = [] } = Astro.props;
// Italics mark a transliteration. When the native name is already in Latin script
// the second line is another language's name, not a romanisation, so it stays upright.
const transliterated = /[^\u0000-\u024F]/.test([].concat(nativeTitle ?? '').join(''));
const lines = (v) => (Array.isArray(v) ? v : [v]).filter((x) => x != null && x !== '');
---
<aside class="infobox">
  <table class="ib">
    <tbody>
      <tr><td class="ib-head" colspan="2">
        <b>{title}</b>
        {lines(nativeTitle).map((n) => <span class="native" set:html={renderInline(n)} />)}
        {romaji && <span class:list={['romaji', !transliterated && 'upright']} set:html={renderInline(romaji)} />}
      </td></tr>
      {rows.map((r) =>
        r.pair ? (
          <tr class="ib-pair">
            {r.pair.map((col) => (
              <td>
                {col.heading && <b set:html={renderInline(col.heading)} />}
                {col.items.map((it) => <div class={it.trimStart().startsWith('•') ? 'sub' : ''} set:html={renderInline(it.replace(/^\s*•\s*/, ''))} />)}
              </td>
            ))}
          </tr>
        ) : r.section ? (
          <tr class="ib-section"><td colspan="2" set:html={renderInline(r.section)} /></tr>
        ) : r.images?.length ? (
          <tr><td class="ib-media ib-media-row" colspan="2">
            {r.images.filter((im) => im.src).map((im) => (
              <figure style="margin:0">
                <img src={asset(im.src)} alt={im.caption || title} />
                {im.caption && <figcaption set:html={renderInline(im.caption)} />}
              </figure>
            ))}
          </td></tr>
        ) : r.image ? (
          <tr><td class="ib-media" colspan="2">
            <figure style="margin:0">
              <img src={asset(r.image)} alt={r.caption || title} />
              {r.caption && <figcaption set:html={renderInline(r.caption)} />}
            </figure>
          </td></tr>
        ) : !r.label ? (
          // A value with no label spans both columns, as a casualty total does.
          <tr><td class="ib-full" colspan="2">{lines(r.value).map((l) => <div set:html={renderInline(l)} />)}</td></tr>
        ) : (
          <tr>
            <th class={r.sub ? 'sub' : undefined} set:html={renderInline(r.label)} />
            <td>{lines(r.value).map((l) => <div set:html={renderInline(l)} />)}</td>
          </tr>
        )
      )}
    </tbody>
  </table>
</aside>
